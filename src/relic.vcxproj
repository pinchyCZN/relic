  <ItemDefinitionGroup>
    <ClCompile>
      <!-- /TC compiles everything as C, not C++. MSVC has no C89
           switch; emscripten's clang with -std=c89 -pedantic is what
           actually catches the lapses, which is why tools/build_web.sh
           is wired up from the start. -->
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>Level4</WarningLevel>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
